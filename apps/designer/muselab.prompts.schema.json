{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muselab.dev/schemas/prompts.schema.json",
  "title": "MuseLab Locale Prompts",
  "description": "Localized scene text and choice labels stored as prompts.<locale>.json inside a .mlvn zip archive.",
  "type": "object",
  "additionalProperties": false,
  "required": ["stories"],
  "properties": {
    "formatVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "MuseLab locale prompts format version."
    },
    "$schema": {
      "type": "string",
      "description": "JSON Schema URL for this prompts file."
    },
    "stories": {
      "type": "object",
      "description": "Localized prompts keyed by story id.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nodes", "edges"],
        "properties": {
          "nodes": {
            "type": "object",
            "description": "Scripted scene actions keyed by node id within the story.",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "actions": {
                  "type": "array",
                  "description": "Ordered scene actions describing everything this scene shows and says.",
                  "items": { "$ref": "#/$defs/sceneAction" }
                }
              }
            }
          },
          "edges": {
            "type": "object",
            "description": "Player choice labels keyed by edge id within the story.",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "optionText": {
                  "type": "string",
                  "description": "Player-facing choice label. Omit or leave empty for auto-advance."
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "positionSlot": {
      "type": "string",
      "enum": [
        "TopLeft",
        "Top",
        "TopRight",
        "FarLeft",
        "Left",
        "Centre",
        "Right",
        "FarRight",
        "BottomLeft",
        "Bottom",
        "BottomRight"
      ]
    },
    "direction": {
      "type": "string",
      "enum": [
        "Left",
        "Right",
        "Top",
        "Bottom",
        "TopLeft",
        "TopRight",
        "BottomLeft",
        "BottomRight"
      ]
    },
    "stagePosition": {
      "description": "Either a named stage slot or explicit coordinates in the 16x9 logical stage.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "slot"],
          "properties": {
            "kind": { "const": "slot" },
            "slot": { "$ref": "#/$defs/positionSlot" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "x", "y"],
          "properties": {
            "kind": { "const": "vec" },
            "x": { "type": "number", "minimum": 0, "maximum": 16 },
            "y": { "type": "number", "minimum": 0, "maximum": 9 }
          }
        }
      ]
    },
    "revealSpec": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "instant",
            "charsPerSecond",
            "wordsPerSecond",
            "charsOverTime",
            "wordsOverTime"
          ]
        },
        "rate": { "type": "number" },
        "durationMs": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "sceneAction": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "bg.show",
            "bg.clear",
            "bg.fade",
            "bg.slideIn",
            "bg.slideOut",
            "prop.add",
            "prop.remove",
            "prop.show",
            "prop.hide",
            "prop.fadeIn",
            "prop.fadeOut",
            "prop.slideIn",
            "prop.slideOut",
            "prop.move",
            "prop.setPosition",
            "prop.setZ",
            "prop.setVariation",
            "prop.highlight",
            "prop.unhighlight",
            "dialogue.show",
            "dialogue.hide",
            "dialogue.setWidth",
            "dialogue.setSpeaker",
            "dialogue.revealText",
            "dialogue.clear",
            "dialogue.reset",
            "wait",
            "waitForContinue",
            "playSound",
            "rt.setBool",
            "rt.setInt",
            "rt.setString",
            "rt.emit"
          ]
        },
        "id": { "type": "string" },
        "assetId": { "type": "string" },
        "variationId": { "type": "string" },
        "characterId": { "type": "string" },
        "widthPercent": { "type": "integer", "minimum": 1, "maximum": 100 },
        "text": { "type": "string" },
        "key": { "type": "string" },
        "eventName": { "type": "string" },
        "value": { "type": ["string", "number", "boolean"] },
        "z": { "type": "number" },
        "milliseconds": { "type": "number", "minimum": 0 },
        "durationMs": { "type": "number", "minimum": 0 },
        "delaySeconds": { "type": "number", "minimum": 0 },
        "startTime": { "type": "number" },
        "endTime": { "type": "number" },
        "direction": { "$ref": "#/$defs/direction" },
        "position": { "$ref": "#/$defs/stagePosition" },
        "reveal": { "$ref": "#/$defs/revealSpec" }
      },
      "additionalProperties": false
    }
  }
}
